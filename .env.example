# =====================================================================
# Aureon — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e preencha. NUNCA versione .env.local.
# Nenhuma variável usa NEXT_PUBLIC_: nada aqui chega ao navegador.
# =====================================================================

# ---------- Supabase (obrigatório) ----------
# Painel do Supabase > Project Settings > API (ou Data API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta "service_role" (ou a nova "secret key"). Só servidor e GitHub Actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Acesso ao painel (obrigatório) ----------
# Senha única do painel. Use algo longo.
ADMIN_PASSWORD=
# Segredo para assinar o cookie de sessão. Mínimo de 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Endereço público do painel (aparece nos relatórios). Ex.: https://aureon-seunome.vercel.app
APP_BASE_URL=http://localhost:3000

# ---------- Mercado Livre (obrigatório para coletar) ----------
# https://developers.mercadolivre.com.br > Minhas aplicações
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Deve ser IGUAL à URI de redirecionamento cadastrada no aplicativo (precisa ser https).
ML_REDIRECT_URI=https://SEU-PAINEL.vercel.app/ml-callback
# Opcional: só para o primeiro uso. Depois de `npm run ml:auth -- --code=...`
# o token fica salvo no banco e é renovado sozinho.
ML_REFRESH_TOKEN=
# Opcional: token fixo para testes rápidos (expira em ~6 horas).
ML_ACCESS_TOKEN=
# Opcional: CEP (só números) para calcular frete quando não é grátis.
ML_ZIP_CODE=

# ---------- E-mail via Resend ----------
RESEND_API_KEY=
# Remetente. Para testes use "Aureon <onboarding@resend.dev>" (só envia para o e-mail da sua conta Resend).
# Em produção, use um endereço de domínio verificado no Resend.
EMAIL_FROM=Aureon <onboarding@resend.dev>
# Destinatário padrão (o painel pode sobrescrever). Vários: separe por vírgula.
REPORT_EMAIL_TO=

# ---------- Telegram (canal principal de alertas) ----------
# Crie o bot com o @BotFather.
TELEGRAM_BOT_TOKEN=
# Seu chat id (o painel pode sobrescrever). Veja o README.
TELEGRAM_CHAT_ID=

# ---------- WhatsApp Cloud API (opcional, etapa posterior) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número de destino no formato internacional, só dígitos. Ex.: 5511999998888
WHATSAPP_TO=
# Nome do modelo aprovado com UMA variável no corpo ({{1}}).
WHATSAPP_TEMPLATE_NAME=alerta_preco
WHATSAPP_TEMPLATE_LANG=pt_BR
# Confira a versão atual da Graph API na documentação da Meta.
WHATSAPP_API_VERSION=v23.0

# ---------- Ajustes da coleta (opcionais) ----------
COLLECTOR_TIMEOUT_MS=15000
# Intervalo mínimo entre requisições à mesma API (limite de taxa).
COLLECTOR_MIN_INTERVAL_MS=400
# "true" faz o workflow falhar (e o GitHub enviar e-mail) quando parte das consultas falha.
FAIL_ON_PARTIAL=false
