{
  "name": "aureon",
  "version": "1.0.0",
  "private": true,
  "description": "Aureon: monitor pessoal de preços (Mercado Livre, Telegram, e-mail e WhatsApp opcional).",
  "engines": {
    "node": ">=22.9.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "job:daily": "tsx --env-file-if-exists=.env.local scripts/daily.ts",
    "job:collect": "tsx --env-file-if-exists=.env.local scripts/daily.ts --skip-alerts --skip-report",
    "job:report": "tsx --env-file-if-exists=.env.local scripts/daily.ts --skip-collect",
    "job:test-notify": "tsx --env-file-if-exists=.env.local scripts/daily.ts --skip-collect --skip-alerts --skip-report --test-notify",
    "ml:auth": "tsx --env-file-if-exists=.env.local scripts/ml-auth.ts",
    "env:check": "tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
